aws_region        = "us-east-1"
project_name      = "mern-ecommerce"
environment       = "aws"
cluster_name      = "mern-ecommerce-eks"
kubernetes_version = "1.34"

vpc_cidr = "10.0.0.0/16"

availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

private_subnet_cidrs = [
  "10.0.11.0/24",
  "10.0.12.0/24"
]

node_instance_types = ["t3.medium"]

node_desired_size = 2
node_min_size     = 2
node_max_size     = 3

db_name              = "ecommerce_audit"
db_username          = "audit_admin"
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20